{
  "name": "@usefy/web",
  "version": "0.0.4",
  "private": true,
  "description": "usefy landing site — introduces every @usefy package with scannable, SEO-first docs",
  "scripts": {
    "build:registry": "node scripts/build-registry.mjs",
    "predev": "node scripts/build-registry.mjs",
    "dev": "next dev -p 3100",
    "prebuild": "node scripts/build-registry.mjs",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .next"
  },
  "dependencies": {
    "@usefy/confetti": "workspace:*",
    "@usefy/diff-viewer": "workspace:*",
    "@usefy/json-viewer": "workspace:*",
    "@usefy/memory-monitor": "workspace:*",
    "@usefy/network-indicator": "workspace:*",
    "@usefy/qr-code": "workspace:*",
    "@usefy/qr-scanner": "workspace:*",
    "@usefy/scroll-progress": "workspace:*",
    "@usefy/signature-pad": "workspace:*",
    "@usefy/spotlight-tour": "workspace:*",
    "@usefy/virtual-keyboard": "workspace:*",
    "@usefy/use-copy-to-clipboard": "workspace:*",
    "@usefy/use-dark-mode": "workspace:*",
    "@usefy/use-hover": "workspace:*",
    "@usefy/use-intersection-observer": "workspace:*",
    "@usefy/use-interval": "workspace:*",
    "@usefy/use-merged-refs": "workspace:*",
    "@usefy/use-reduced-motion": "workspace:*",
    "@usefy/use-toggle": "workspace:*",
    "next": "^15.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.1",
    "shiki": "^1.29.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3"
  }
}
