{
  "name": "@usefy/web",
  "version": "0.0.0",
  "private": true,
  "description": "usefy landing site — introduces every @usefy package with scannable, SEO-first docs",
  "scripts": {
    "build:registry": "node scripts/build-registry.mjs",
    "predev": "node scripts/build-registry.mjs",
    "dev": "next dev -p 3100",
    "prebuild": "node scripts/build-registry.mjs",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .next"
  },
  "dependencies": {
    "@usefy/use-copy-to-clipboard": "workspace:*",
    "@usefy/use-dark-mode": "workspace:*",
    "@usefy/use-toggle": "workspace:*",
    "next": "^15.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.1",
    "shiki": "^1.29.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3"
  }
}
