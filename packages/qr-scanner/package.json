{
  "name": "@usefy/qr-scanner",
  "version": "0.1.0",
  "description": "QR code scanner for React — the platform's native BarcodeDetector where it exists, a hand-written ISO/IEC 18004 decoder where it doesn't: camera and still image, Reed–Solomon error correction, perspective correction, ECI, and a zero-dependency headless core",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.mjs",
      "require": "./dist/headless.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.mjs",
      "require": "./dist/worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/worker.js",
    "./dist/worker.mjs",
    "./src/worker.ts"
  ],
  "scripts": {
    "build": "rimraf dist && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/measure-size.mjs",
    "bench": "node scripts/bench-decode.mjs",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@usefy/qr-code": "workspace:*",
    "@usefy/use-controllable-state": "workspace:*",
    "@usefy/use-event-callback": "workspace:*",
    "@usefy/use-event-listener": "workspace:*",
    "@usefy/use-isomorphic-layout-effect": "workspace:*",
    "@usefy/use-page-visibility": "workspace:*",
    "@usefy/use-reduced-motion": "workspace:*",
    "@usefy/use-user-media": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.12",
    "jsdom": "^26.0.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "@types/qrcode": "^1.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.0.16"
  },
  "keywords": [
    "react",
    "qr",
    "qrcode",
    "qr-scanner",
    "barcode",
    "scanner",
    "decoder",
    "camera",
    "barcodedetector",
    "reed-solomon",
    "headless"
  ],
  "author": "usefy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mirunamu00/usefy.git",
    "directory": "packages/qr-scanner"
  },
  "bugs": {
    "url": "https://github.com/mirunamu00/usefy/issues"
  },
  "homepage": "https://usefy-web.vercel.app/packages/qr-scanner",
  "publishConfig": {
    "access": "public"
  }
}
